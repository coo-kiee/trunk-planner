<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Test APK only: the isolated local relay is cleartext. The library manifest stays cleartext-free. -->
    <application android:usesCleartextTraffic="true">
        <!-- Separate OS process, so that each stage starts with no memory of the one before. -->
        <service android:name="ai.cargo.sync.SyncWorkerService" android:process=":syncworker" android:exported="false" />
    </application>
</manifest>
