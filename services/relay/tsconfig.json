{
  "compilerOptions": {
    "strict": true, "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true, "noEmit": true, "verbatimModuleSyntax": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noUncheckedIndexedAccess": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
