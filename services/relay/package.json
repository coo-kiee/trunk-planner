{
  "name": "@cargo/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node src/main.ts",
    "migrate": "node src/bin/migrate.ts",
    "cleanup": "node src/bin/cleanup.ts",
    "dev:local": "node test/support/local-stack.ts",
    "report": "node test/support/build-report.ts",
    "test:postgres": "node test/support/run-suite.ts postgres",
    "test:protocol": "node test/support/run-suite.ts protocol"
  },
  "dependencies": {
    "canonicalize": "2.1.0",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.11.10",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "5.7.3"
  }
}
